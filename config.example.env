# Databas — PostgreSQL rekommenderas (krävs för vektorsökning)
DATABASE_URL=postgresql://mitt_db_anvandare:byt_till_eget_starkt_losenord@localhost:5432/riksdag

# SQLite-fallback (inget vektorsökning)
# DATABASE_URL=sqlite:///gov_cache.db

# MCP-transport: stdio (standard för lokal användning) eller http
MCP_TRANSPORT=stdio

# HTTP-läge — används om MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8009
MCP_API_KEY=genereras_med_secrets_token_hex_32

# Nedladdning
# Antal parallella PDF-nedladdningar (rekommenderat: 3–5)
PDF_DOWNLOAD_WORKERS=4
# Paus mellan nedladdningar i sekunder (respektera servern)
PDF_DOWNLOAD_DELAY=0.5
# Sökväg till PDF-cache (standard: ./pdf_cache)
PDF_CACHE_DIR=./pdf_cache
# Sökväg till JSON-cache (standard: ./json_cache)
JSON_CACHE_DIR=./json_cache

# Embeddingmodell
EMBEDDING_MODEL=KBLab/sentence-bert-swedish-cased

# Schemaläggning — används av --installera-schema i 03_synka_data.py
# Välj: cron (Linux och macOS) eller launchd (macOS)
SCHEMALAGGARE=cron

# Tid för daglig körning i cron-format (standard: 06:45 varje dag)
# OBS: Använd lokal tid. g0v.se uppdateras ca 06:35 — lägg till 10 min marginal.
CRON_SCHEMA=45 6 * * *

# Absolut sökväg till Python-tolken i din virtuella miljö
# Kör 'which python' (eller 'which python3') i aktiverad venv för att hitta den.
PYTHON_SOKVÄG=/usr/local/bin/python3

# Remissvar — antal dagar lokalt cache är giltigt (standard: 365)
REMISSVAR_CACHE_TTL_DAYS=365

# PDF-cache TTL — säkerhetsventil för stada_pdf_cache() (körs vid daglig synk)
# Radera inte PDF-filer yngre än detta antal dagar även om fulltexten finns i databasen.
# Pipeline raderar alltid direkt efter lyckad extraktion; detta städar upp eventuella rester.
# Standard: 1 dag
PDF_CACHE_TTL_DAGAR=1

# Dokumenttyper — styr vad som bulk-indexeras vs hämtas on-demand
# Kommaseparerade typkoder (se g0v.se för fullständig lista)
# Bulk-typer indexeras vid daglig sync (remissmissiv=1326, int.överenskommelser=2099, förordningsmotiv=1332)
BULK_TYPER=1326,2099,1332
# On-demand-typer hämtas endast när gov_get_document anropas (lagrådsremiss=2085, komm.dagordning=2098)
ON_DEMAND_TYPER=2085,2098

# Ärendeförteckningar (beslut pre-sept 2024)
# Aktivera on-demand-hämtning av ärendeförteckningar från /arendeforteckningar/
ARENDEFORTECKNING_AKTIV=true
# Antal dagar lokalt cache är giltigt (0 = aldrig utgånget, rekommenderat för historiska dokument)
ARENDEFORTECKNING_CACHE_TTL_DAYS=0
